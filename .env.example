# Copy this file to .env (production on the VPS) or .env.local (dev) and
# fill in real values before running the app.

# Password for the /admin login. Change this before deploying.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# Only set this if deploying under a subpath of an existing domain
# (e.g. https://example.com/phongchothue/) instead of the domain root.
# Leave unset for local dev / a dedicated domain.
# NEXT_PUBLIC_BASE_PATH=/phongchothue

# MySQL/MariaDB connection (see README.md "Data storage" section for how to
# create the database + run the first-time migration).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=change-me
